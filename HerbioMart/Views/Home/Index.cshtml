@{
    ViewData["Title"] = "Natural Herbs & Certified Recipes";
}

<!-- Hero Start -->
<div class="container-fluid py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-md-12 col-lg-7">
                <h4 class="mb-3 text-secondary">100% Pure & Organic Remedies</h4>
                <h1 class="mb-5 display-3 text-primary">Natural Herbs & Medical Recipes</h1>
                <div class="position-relative mx-auto">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary border-2 border-secondary py-3 px-5 rounded-pill text-white">
                        Explore Catalog Now <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-12 col-lg-5">
                <div id="carouselId" class="carousel slide position-relative" data-bs-ride="carousel">
                    <div class="carousel-inner" role="listbox">
                        <div class="carousel-item active rounded">
                            <img src="~/img/hero-img-1.png" class="img-fluid w-100 h-100 bg-secondary rounded" alt="Single Herbs">
                            <a asp-controller="Shop" asp-action="Index" class="btn px-4 py-2 text-white rounded">Single Herbs</a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/img/hero-img-2.jpg" class="img-fluid w-100 h-100 rounded" alt="Formulated Recipes">
                            <a asp-controller="Shop" asp-action="Index" class="btn px-4 py-2 text-white rounded">Medical Recipes</a>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!-- Features Section Start -->
<div class="container-fluid featurs py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-mortar-pestle fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Certified Formulations</h5>
                        <p class="mb-0">Prepared by accredited herbalists</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-heartbeat fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Condition Matching</h5>
                        <p class="mb-0">Matched directly against diseases</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-file-prescription fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Dosage Guidelines</h5>
                        <p class="mb-0">Clear usage warnings & directions</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fa fa-truck fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Direct Dispatch</h5>
                        <p class="mb-0">Delivered directly from apothecaries</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Features Section End -->
<!-- Catalog Shop Start-->
<div class="container-fluid fruite py-5">
    <div class="container py-5">
        <div class="tab-class text-center">
            <div class="row g-4">
                <div class="col-lg-4 text-start">
                    <h1>Featured Remedies</h1>
                </div>
                <div class="col-lg-8 text-end">
                    <ul class="nav nav-pills d-inline-flex text-center mb-5">
                        <li class="nav-item">
                            <a class="d-flex m-2 py-2 bg-light rounded-pill active" data-bs-toggle="pill" href="#tab-all">
                                <span class="text-dark" style="width: 140px;">All Offerings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="d-flex py-2 m-2 bg-light rounded-pill" data-bs-toggle="pill" href="#tab-recipes">
                                <span class="text-dark" style="width: 140px;">Prepared Recipes</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="d-flex m-2 py-2 bg-light rounded-pill" data-bs-toggle="pill" href="#tab-herbs">
                                <span class="text-dark" style="width: 140px;">Raw Herbs</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="tab-content">
                <div id="tab-all" class="tab-pane fade show p-0 active">
                    <div class="row g-4">
                        <div class="col-md-6 col-lg-4 col-xl-3">
                            <div class="rounded position-relative fruite-item border border-secondary">
                                <div class="fruite-img">
                                    <img src="~/img/fruite-item-5.jpg" class="img-fluid w-100 rounded-top" alt="Remedy">
                                </div>
                                <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Recipe</div>
                                <div class="p-4 border-top-0 rounded-bottom">
                                    <h4>Digestive Compound</h4>
                                    <p>Standardized mixture crafted for gastrointestinal soothe and cramps.</p>
                                    <div class="d-flex justify-content-between flex-lg-wrap">
                                        <p class="text-dark fs-5 fw-bold mb-0">120.00 EGP</p>
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="1" class="btn border border-secondary rounded-pill px-3 text-primary">
                                            <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4 col-xl-3">
                            <div class="rounded position-relative fruite-item border border-secondary">
                                <div class="fruite-img">
                                    <img src="~/img/fruite-item-2.jpg" class="img-fluid w-100 rounded-top" alt="Herb">
                                </div>
                                <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Herb</div>
                                <div class="p-4 border-top-0 rounded-bottom">
                                    <h4>Dried Chamomile</h4>
                                    <p>Select blossoms for natural calming, relaxation, and digestive support.</p>
                                    <div class="d-flex justify-content-between flex-lg-wrap">
                                        <p class="text-dark fs-5 fw-bold mb-0">45.00 EGP</p>
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="2" class="btn border border-secondary rounded-pill px-3 text-primary">
                                            <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Catalog Shop End-->
<!-- Fact Counter Start -->
<div class="container-fluid py-5">
    <div class="container">
        <div class="bg-light p-5 rounded">
            <div class="row g-4 justify-content-center">
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded p-5 text-center">
                        <i class="fa fa-users fa-2x text-secondary mb-3"></i>
                        <h4>Active Patients</h4>
                        <h1 class="fw-bold">1,250+</h1>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded p-5 text-center">
                        <i class="fa fa-store fa-2x text-secondary mb-3"></i>
                        <h4>Licensed Apothecaries</h4>
                        <h1 class="fw-bold">48</h1>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded p-5 text-center">
                        <i class="fa fa-leaf fa-2x text-secondary mb-3"></i>
                        <h4>Herbal Formulations</h4>
                        <h1 class="fw-bold">340+</h1>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded p-5 text-center">
                        <i class="fa fa-check-circle fa-2x text-secondary mb-3"></i>
                        <h4>Conditions Covered</h4>
                        <h1 class="fw-bold">85</h1>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fact Counter End -->