@{
    ViewData["Title"] = "Natural Herbs & Certified Recipes";
}

<!-- Hero Start -->
<div class="container-fluid py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-md-12 col-lg-7">
                <h4 class="mb-3 text-secondary">100% Pure & Organic Remedies</h4>
                <h1 class="mb-5 display-3 text-primary">Natural Herbs & Medical Recipes</h1>
                <div class="position-relative mx-auto">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary border-2 border-secondary py-3 px-5 rounded-pill text-white">
                        Explore Catalog Now <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-12 col-lg-5">
                <div id="carouselId" class="carousel slide position-relative" data-bs-ride="carousel">
                    <div class="carousel-inner" role="listbox">
                        <div class="carousel-item active rounded">
                            <img src="~/img/hero-img-1.jpg" class="img-fluid w-100 h-100 bg-secondary rounded" alt="Single Herbs">
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/img/hero-img-4.jpg" class="img-fluid w-100 h-100 rounded" alt="Formulated Recipes">
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/img/hero-img-3.jpg" class="img-fluid w-100 h-100 rounded" alt="Formulated Recipes">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!-- Features Section Start -->
<div class="container-fluid featurs py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-mortar-pestle fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Certified Formulations</h5>
                        <p class="mb-0">Prepared by accredited herbalists</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-heartbeat fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Condition Matching</h5>
                        <p class="mb-0">Matched directly against diseases</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-file-prescription fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Dosage Guidelines</h5>
                        <p class="mb-0">Clear usage warnings & directions</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fa fa-truck fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Direct Dispatch</h5>
                        <p class="mb-0">Direct from apothecaries</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Component.InvokeAsync("FeaturedRemedies")
@await Component.InvokeAsync("SiteStats")
