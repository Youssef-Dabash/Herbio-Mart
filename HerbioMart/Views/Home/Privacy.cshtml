@{
    ViewData["Title"] = "About & System Overview";
}

<style>
    /* حل تداخل المحتوى مع الـ Fixed Navbar */
    .page-content-wrapper {
        margin-top: 150px;
        min-height: 80vh;
    }

    .team-card {
        border-radius: 16px;
        border: 1px solid #e9ecef;
        background: #ffffff;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.07);
        }

    .team-icon-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background-color: #f0fdf4;
        color: #16a34a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 1.25rem;
        border: 2px solid #bbf7d0;
    }

    /* Badges مخصصة عالية التباين تضمن وضوح النص تماماً */
    .custom-pill {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-align: center;
        margin-bottom: 1rem;
    }

    .pill-green {
        background-color: #dcfce7 !important;
        color: #15803d !important;
        border: 1px solid #86efac;
    }

    .pill-blue {
        background-color: #dbeafe !important;
        color: #1d4ed8 !important;
        border: 1px solid #93c5fd;
    }

    .pill-amber {
        background-color: #fef3c7 !important;
        color: #b45309 !important;
        border: 1px solid #fcd34d;
    }

    .pill-purple {
        background-color: #ede9fe !important;
        color: #6d28d9 !important;
        border: 1px solid #c4b5fd;
    }

    .policy-card {
        background: #f8fafc;
        border-radius: 14px;
        border-left: 4px solid #16a34a;
    }
</style>

<div class="container page-content-wrapper py-4">

    <!-- 1. Header Section -->
    <div class="text-center mx-auto mb-5" style="max-width: 720px;">
        <div class="custom-pill pill-green mb-3">
            Graduation Project & System Overview
        </div>
        <h1 class="display-5 fw-bold text-dark mb-3">About HerbioMart</h1>
        <p class="text-muted fs-6 mb-0" style="line-height: 1.7;">
            A specialized healthcare & botanical remedies web application built purely with <strong>ASP.NET Core MVC</strong>, facilitating natural remedy management and direct ordering between patients and licensed apothecaries.
        </p>
    </div>

    <!-- 2. The 4 Backend Developers Team -->
    <div class="mb-5">
        <div class="d-flex align-items-center mb-4">
            <i class="fas fa-users-cog fa-2x text-primary me-3"></i>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Backend Engineering Team</h3>
                <small class="text-muted">Four Backend Developers responsible for core system logic, database design, and MVC modules</small>
            </div>
        </div>

        <div class="row g-4">
            <!-- Developer 1: Patient & Medical History -->
            <div class="col-sm-6 col-lg-3">
                <div class="team-card p-4 text-center h-100 d-flex flex-column">
                    <div class="team-icon-circle">
                        <i class="fas fa-user-injured"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Backend Developer</h5>

                    <div>
                        <span class="custom-pill pill-blue">
                            Patient & Medical History
                        </span>
                    </div>

                    <p class="text-muted small flex-grow-1" style="font-size: 0.82rem; line-height: 1.6;">
                        Developed Patient Portal controllers, CRUD workflows, and the secure Upsert mechanism for clinical medical histories without deletion.
                    </p>
                    <div class="border-top pt-3 mt-auto">
                        <small class="text-muted fw-semibold d-block">ASP.NET Core MVC</small>
                    </div>
                </div>
            </div>

            <!-- Developer 2: Herbalist & Formulations -->
            <div class="col-sm-6 col-lg-3">
                <div class="team-card p-4 text-center h-100 d-flex flex-column">
                    <div class="team-icon-circle">
                        <i class="fas fa-mortar-pestle"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Backend Developer</h5>

                    <div>
                        <span class="custom-pill pill-green">
                            Apothecary & Catalog
                        </span>
                    </div>

                    <p class="text-muted small flex-grow-1" style="font-size: 0.82rem; line-height: 1.6;">
                        Implemented Herbalist dispensary modules, raw herbs catalog, formulation recipe builders, and disease-remedy relational mapping.
                    </p>
                    <div class="border-top pt-3 mt-auto">
                        <small class="text-muted fw-semibold d-block">EF Core & Relational Data</small>
                    </div>
                </div>
            </div>

            <!-- Developer 3: Orders, Cart & Checkout -->
            <div class="col-sm-6 col-lg-3">
                <div class="team-card p-4 text-center h-100 d-flex flex-column">
                    <div class="team-icon-circle">
                        <i class="fas fa-shopping-basket"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Backend Developer</h5>

                    <div>
                        <span class="custom-pill pill-amber">
                            Orders & Sub-orders
                        </span>
                    </div>

                    <p class="text-muted small flex-grow-1" style="font-size: 0.82rem; line-height: 1.6;">
                        Engineered the shopping cart pipeline, checkout transactions, and multi-vendor sub-order routing directly to specific apothecaries.
                    </p>
                    <div class="border-top pt-3 mt-auto">
                        <small class="text-muted fw-semibold d-block">Order Processing Workflow</small>
                    </div>
                </div>
            </div>

            <!-- Developer 4: Auth, Security & Analytics -->
            <div class="col-sm-6 col-lg-3">
                <div class="team-card p-4 text-center h-100 d-flex flex-column">
                    <div class="team-icon-circle">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Backend Developer</h5>

                    <div>
                        <span class="custom-pill pill-purple">
                            Auth, Security & Stats
                        </span>
                    </div>

                    <p class="text-muted small flex-grow-1" style="font-size: 0.82rem; line-height: 1.6;">
                        Engineered custom authentication & role-based access (Patient vs. Herbalist), user feedback reviews, and real-time site analytical counters.
                    </p>
                    <div class="border-top pt-3 mt-auto">
                        <small class="text-muted fw-semibold d-block">Custom Auth & Security</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Standard Technology Stack -->
    <div class="bg-light p-4 rounded-4 border mb-5">
        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-layer-group text-primary me-2"></i>Project Technology Stack</h5>
        <div class="row g-3 text-muted small">
            <div class="col-md-3">
                <i class="fas fa-check-circle text-success me-1"></i> <strong>Framework:</strong> ASP.NET Core MVC
            </div>
            <div class="col-md-3">
                <i class="fas fa-check-circle text-success me-1"></i> <strong>ORM:</strong> Entity Framework Core
            </div>
            <div class="col-md-3">
                <i class="fas fa-check-circle text-success me-1"></i> <strong>Database:</strong> Microsoft SQL Server
            </div>
            <div class="col-md-3">
                <i class="fas fa-check-circle text-success me-1"></i> <strong>Security:</strong> Custom Role-Based Auth
            </div>
        </div>
    </div>

    <!-- 4. Clinical Privacy & Data Protection -->
    <div class="mb-4">
        <div class="d-flex align-items-center mb-4">
            <i class="fas fa-shield-alt fa-2x text-success me-3"></i>
            <div>
                <h3 class="fw-bold mb-0 text-dark">System Privacy & Clinical Data Policy</h3>
                <small class="text-muted">How patient medical history and dispensary records are protected</small>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-4 policy-card h-100 border shadow-sm">
                    <h5 class="fw-bold text-dark mb-2"><i class="fas fa-file-medical text-danger me-2"></i>Medical Record Integrity</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Patient medical histories (allergies, chronic conditions, and past surgeries) follow strict <strong>Upsert</strong> logic with zero raw deletion to preserve long-term health record integrity and auditability.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 policy-card h-100 border shadow-sm">
                    <h5 class="fw-bold text-dark mb-2"><i class="fas fa-user-lock text-primary me-2"></i>Strict Role Segregation</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Apothecaries and vendors have access strictly to incoming sub-orders and remedy preparation details. Complete patient profiles and clinical records remain private to the patient.
                    </p>
                </div>
            </div>
        </div>
    </div>

</div>