@{
    ViewData["Title"] = "Patient Testimonials";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Patient Stories</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-white">Shop</a></li>
        <li class="breadcrumb-item active text-white">Testimonials</li>
    </ol>
</div>
<!-- Single Page Header End -->
<!-- Testimonial Start -->
<div class="container-fluid testimonial py-5">
    <div class="container py-5">
        <div class="testimonial-header text-center">
            <h4 class="text-primary">Verified Feedback</h4>
            <h1 class="display-5 mb-5 text-dark">What Our Patients Say!</h1>
        </div>
        <div class="owl-carousel testimonial-carousel">
            <div class="testimonial-item img-border-radius bg-light rounded p-4">
                <div class="position-relative">
                    <i class="fa fa-quote-right fa-2x text-secondary position-absolute" style="bottom: 30px; right: 0;"></i>
                    <div class="mb-4 pb-4 border-bottom border-secondary">
                        <p class="mb-0">
                            The organic chamomile recipe from Al-Azhar Apothecary helped alleviate my chronic IBS symptoms within two weeks. Excellent dosage instructions!
                        </p>
                    </div>
                    <div class="d-flex align-items-center flex-nowrap">
                        <div class="bg-secondary rounded">
                            <img src="~/img/testimonial-1.jpg" class="img-fluid rounded" style="width: 100px; height: 100px;" alt="Ahmed M.">
                        </div>
                        <div class="ms-4 d-block">
                            <h4 class="text-dark">Ahmed Mostafa</h4>
                            <p class="m-0 pb-3 text-muted">Verified Patient</p>
                            <div class="d-flex pe-5 text-primary">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="testimonial-item img-border-radius bg-light rounded p-4">
                <div class="position-relative">
                    <i class="fa fa-quote-right fa-2x text-secondary position-absolute" style="bottom: 30px; right: 0;"></i>
                    <div class="mb-4 pb-4 border-bottom border-secondary">
                        <p class="mb-0">
                            Finding licensed herbalists who cross-check allergies before dispatching blends is a game-changer. The hypertension herbal tea is outstanding.
                        </p>
                    </div>
                    <div class="d-flex align-items-center flex-nowrap">
                        <div class="bg-secondary rounded">
                            <img src="~/img/testimonial-1.jpg" class="img-fluid rounded" style="width: 100px; height: 100px;" alt="Sarah K.">
                        </div>
                        <div class="ms-4 d-block">
                            <h4 class="text-dark">Sarah Khalil</h4>
                            <p class="m-0 pb-3 text-muted">Verified Patient</p>
                            <div class="d-flex pe-5 text-primary">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star text-muted"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="testimonial-item img-border-radius bg-light rounded p-4">
                <div class="position-relative">
                    <i class="fa fa-quote-right fa-2x text-secondary position-absolute" style="bottom: 30px; right: 0;"></i>
                    <div class="mb-4 pb-4 border-bottom border-secondary">
                        <p class="mb-0">
                            Fast dispatch and pure unadulterated herbs. Having clear medical guidelines and contraindications printed on the recipe package gave me peace of mind.
                        </p>
                    </div>
                    <div class="d-flex align-items-center flex-nowrap">
                        <div class="bg-secondary rounded">
                            <img src="~/img/testimonial-1.jpg" class="img-fluid rounded" style="width: 100px; height: 100px;" alt="Tarek N.">
                        </div>
                        <div class="ms-4 d-block">
                            <h4 class="text-dark">Tarek Nabil</h4>
                            <p class="m-0 pb-3 text-muted">Verified Patient</p>
                            <div class="d-flex pe-5 text-primary">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Testimonial End -->