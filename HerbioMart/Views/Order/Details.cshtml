@using HerbioMart.Models.Enums
@model HerbioMart.Models.Entities.Order

@{
    ViewData["Title"] = $"Order #{Model.OrderId} - Tracking";

    int currentStep = Model.OrderStatus switch
    {
        OrderStatus.Pending => 1,
        OrderStatus.Processing => 2,
        OrderStatus.Completed => 3,
        _ => 1
    };
    bool isCancelled = Model.OrderStatus == OrderStatus.Cancelled;
}

<style>
    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-bottom: 2.5rem;
    }

        .stepper-wrapper::before {
            content: '';
            position: absolute;
            top: 25px;
            left: 10%;
            right: 10%;
            height: 4px;
            background-color: #e2e8f0;
            z-index: 1;
        }

    .stepper-progress {
        position: absolute;
        top: 25px;
        left: 10%;
        height: 4px;
        background-color: #16a34a;
        z-index: 2;
        transition: width 0.4s ease;
    }

    .stepper-item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        z-index: 3;
    }

    .stepper-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: #ffffff;
        border: 3px solid #cbd5e1;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }

    .stepper-item.completed .stepper-circle {
        background-color: #16a34a !important;
        border-color: #16a34a !important;
        color: #ffffff !important;
    }

    .stepper-item.active .stepper-circle {
        border-color: #16a34a !important;
        color: #16a34a !important;
        box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.2);
    }

    .stepper-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
    }

    .status-badge-pending {
        background-color: #fef3c7 !important;
        color: #92400e !important;
        border: 1px solid #fcd34d !important;
        font-weight: 700 !important;
        font-size: 0.75rem !important;
        padding: 5px 14px !important;
        border-radius: 50rem !important;
        display: inline-flex !important;
        align-items: center !important;
    }

    .status-badge-accepted {
        background-color: #e0f2fe !important;
        color: #0369a1 !important;
        border: 1px solid #7dd3fc !important;
        font-weight: 700 !important;
        font-size: 0.75rem !important;
        padding: 5px 14px !important;
        border-radius: 50rem !important;
        display: inline-flex !important;
        align-items: center !important;
    }

    .status-badge-shipped {
        background-color: #dcfce7 !important;
        color: #15803d !important;
        border: 1px solid #86efac !important;
        font-weight: 700 !important;
        font-size: 0.75rem !important;
        padding: 5px 14px !important;
        border-radius: 50rem !important;
        display: inline-flex !important;
        align-items: center !important;
    }

    .status-badge-cancelled {
        background-color: #fee2e2 !important;
        color: #991b1b !important;
        border: 1px solid #fca5a5 !important;
        font-weight: 700 !important;
        font-size: 0.75rem !important;
        padding: 5px 14px !important;
        border-radius: 50rem !important;
        display: inline-flex !important;
        align-items: center !important;
    }

    .vendor-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: #16a34a !important;
        color: #ffffff !important;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5 mb-4">
    <h1 class="text-center text-white display-6 fw-bold">Live Order Tracking</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Order" asp-action="Index" class="text-white">My Orders</a></li>
        <li class="breadcrumb-item active text-white">#@Model.OrderId</li>
    </ol>
</div>

<div class="container py-4">

    <!-- Top Status Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Order Reference</span>
                <h4 class="fw-bold text-dark mb-0 font-monospace">#@Model.OrderId</h4>
                <small class="text-muted">Placed: @Model.OrderDate.ToString("MMMM dd, yyyy - hh:mm tt")</small>
            </div>

            <div class="text-end">
                <span class="text-muted small d-block mb-1">Overall Status</span>
                @if (Model.OrderStatus == OrderStatus.Completed)
                {
                    <span class="status-badge-shipped fs-6">
                        <i class="fas fa-check-circle me-1"></i> Completed
                    </span>
                }
                else if (Model.OrderStatus == OrderStatus.Processing)
                {
                    <span class="status-badge-accepted fs-6">
                        <i class="fas fa-spinner fa-spin me-1"></i> Processing & Preparing
                    </span>
                }
                else if (Model.OrderStatus == OrderStatus.Cancelled)
                {
                    <span class="status-badge-cancelled fs-6">
                        <i class="fas fa-times-circle me-1"></i> Cancelled
                    </span>
                }
                else
                {
                    <span class="status-badge-pending fs-6">
                        <i class="fas fa-clock me-1"></i> Pending Verification
                    </span>
                }
            </div>
        </div>

        <hr class="my-4" />

        <!-- Stepper -->
        @if (isCancelled)
        {
            <div class="alert alert-danger rounded-3 mb-0 text-center py-3">
                <i class="fas fa-exclamation-triangle me-2"></i> This order was cancelled. Please reach out to customer support for inquiries.
            </div>
        }
        else
        {
            <div class="stepper-wrapper mt-3">
                @{
                    var progressWidth = currentStep == 1 ? "0%" : currentStep == 2 ? "50%" : "80%";
                }
                <div class="stepper-progress" style="width: @progressWidth;"></div>

                <div class="stepper-item @(currentStep >= 1 ? "completed" : "")">
                    <div class="stepper-circle">
                        <i class="fas fa-receipt"></i>
                    </div>
                    <span class="stepper-title">Order Placed</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Order Logged</small>
                </div>

                <div class="stepper-item @(currentStep > 2 ? "completed" : currentStep == 2 ? "active" : "")">
                    <div class="stepper-circle">
                        <i class="fas fa-mortar-pestle"></i>
                    </div>
                    <span class="stepper-title">Preparation</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Vendors Packaging</small>
                </div>

                <div class="stepper-item @(currentStep == 3 ? "completed" : "")">
                    <div class="stepper-circle">
                        <i class="fas fa-truck"></i>
                    </div>
                    <span class="stepper-title">Dispatched / Delivered</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Fulfilled</small>
                </div>
            </div>
        }
    </div>

    <!-- Grid -->
    <div class="row g-4">

        <!-- Left: SubOrders -->
        <div class="col-lg-8">
            <h5 class="fw-bold text-dark mb-3">
                <i class="fas fa-store-alt text-success me-2"></i>Apothecary Dispensary Packages (@Model.SubOrders.Count)
            </h5>

            @foreach (var sub in Model.SubOrders)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden bg-white">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="vendor-avatar me-2">
                                <i class="fas fa-user-check text-white"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">Dispensary: @sub.Herbalist.User.FullName</h6>
                                <small class="text-muted font-monospace" style="font-size: 0.75rem;">Package: #SUB-@sub.SubOrderId</small>
                            </div>
                        </div>

                        <div>
                            @if (sub.Status == SubOrderStatus.Shipped)
                            {
                                <span class="status-badge-shipped">
                                    <i class="fas fa-shipping-fast me-1"></i> Shipped
                                </span>
                            }
                            else if (sub.Status == SubOrderStatus.Accepted)
                            {
                                <span class="status-badge-accepted">
                                    <i class="fas fa-box-open me-1"></i> Preparing
                                </span>
                            }
                            else if (sub.Status == SubOrderStatus.Cancelled)
                            {
                                <span class="status-badge-cancelled">
                                    <i class="fas fa-times-circle me-1"></i> Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="status-badge-pending">
                                    <i class="fas fa-clock me-1"></i> Pending
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Item</th>
                                        <th>Type</th>
                                        <th class="text-center">Weight / Quantity</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var herb in sub.OrderHerbs)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">
                                                <i class="fas fa-leaf text-success me-1"></i> @herb.Herb.HerbName
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1">Herb</span>
                                            </td>
                                            <td class="text-center font-monospace">@herb.Quantity g</td>
                                            <td class="text-end font-monospace fw-bold text-dark">@herb.SubTotal.ToString("0.00") EGP</td>
                                        </tr>
                                    }
                                    @foreach (var recipe in sub.OrderRecipes)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">
                                                <i class="fas fa-mortar-pestle text-primary me-1"></i> @recipe.Recipe.RecipeName
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1">Remedy</span>
                                            </td>
                                            <td class="text-center font-monospace">@recipe.Quantity unit(s)</td>
                                            <td class="text-end font-monospace fw-bold text-dark">@recipe.SubTotal.ToString("0.00") EGP</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Dispensary Subtotal:</small>
                        <span class="fw-bold font-monospace text-success fs-6">@sub.SubTotal.ToString("0.00") EGP</span>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Address & Bill -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fas fa-map-marker-alt text-danger me-2"></i>Delivery Details
                </h6>
                <p class="text-muted small mb-0" style="line-height: 1.8;">
                    @Model.ShippingAddress
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Billing Summary</h6>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Items Total:</span>
                    <span class="fw-bold font-monospace text-dark">@Model.ItemsTotal.ToString("0.00") EGP</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Standard Delivery:</span>
                    <span class="fw-bold font-monospace text-dark">@Model.DeliveryFee.ToString("0.00") EGP</span>
                </div>

                <hr class="my-2" />

                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <span class="fw-bold text-dark fs-5">Total Paid:</span>
                    <span class="fw-bold text-success font-monospace fs-4">@Model.TotalPrice.ToString("0.00") EGP</span>
                </div>

                <a asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 w-100 fw-semibold">
                    <i class="fas fa-arrow-left me-1"></i> Back to My Orders
                </a>
            </div>
        </div>

    </div>

</div>