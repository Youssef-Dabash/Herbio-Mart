@using HerbioMart.Models.Enums
@model HerbioMart.ViewModels.Auth.RegisterVM

@{
    ViewData["Title"] = "Create an Account";
}

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-sm-5">
                    <div class="text-center mb-4">
                        <h4 class="text-primary text-uppercase">Join HerbioMart</h4>
                        <h2 class="fw-bold text-dark">Register Account</h2>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label text-secondary fw-semibold">Full Name</label>
                                <input asp-for="FullName" class="form-control rounded-pill py-2 px-3" placeholder="Full name" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserName" class="form-label text-secondary fw-semibold">Username</label>
                                <input asp-for="UserName" class="form-control rounded-pill py-2 px-3" placeholder="username" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label text-secondary fw-semibold">Email Address</label>
                                <input asp-for="Email" class="form-control rounded-pill py-2 px-3" placeholder="user@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label text-secondary fw-semibold">Phone Number</label>
                                <input asp-for="Phone" class="form-control rounded-pill py-2 px-3" placeholder="01012345678" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label text-secondary fw-semibold">Password</label>
                                <input asp-for="Password" type="password" class="form-control rounded-pill py-2 px-3" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label text-secondary fw-semibold">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control rounded-pill py-2 px-3" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold d-block">Account Role</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input asp-for="Role" type="radio" value="@UserRole.Patient" class="form-check-input" id="rolePatient" checked />
                                    <label class="form-check-label" for="rolePatient">
                                        <i class="fas fa-user-injured text-primary me-1"></i> Patient
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Role" type="radio" value="@UserRole.Herbalist" class="form-check-input" id="roleHerbalist" />
                                    <label class="form-check-label" for="roleHerbalist">
                                        <i class="fas fa-leaf text-success me-1"></i> Herbalist
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">Register</button>

                        <div class="text-center mt-3">
                            <small class="text-muted">Already registered? <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold">Sign in here</a></small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>