@model HerbioMart.ViewModels.Auth.LoginVM

@{
    ViewData["Title"] = "Sign In";
}

<div class="container-fluid py-5" style="margin-top: 160px; margin-bottom: 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-5">
                <div class="card border-0 shadow rounded-4 p-4 p-sm-5 bg-white">
                    <div class="text-center mb-4">
                        <span class="text-primary text-uppercase fw-bold small d-block mb-1">Welcome Back</span>
                        <h2 class="fw-bold text-dark">Sign In</h2>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="EmailOrUserName" class="form-label text-secondary fw-semibold small">Email or Username</label>
                            <input asp-for="EmailOrUserName" class="form-control rounded-pill py-2 px-3 border" placeholder="user@example.com or username" />
                            <span asp-validation-for="EmailOrUserName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-secondary fw-semibold small">Password</label>
                            <input asp-for="Password" type="password" class="form-control rounded-pill py-2 px-3 border" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label text-secondary small">Remember Me</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 text-white fw-bold shadow-sm">
                            Login
                        </button>

                        <div class="text-center mt-4">
                            <small class="text-muted">
                                Don't have an account?
                                <a asp-controller="Account" asp-action="Register" class="text-primary fw-bold text-decoration-none">Register here</a>
                            </small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}