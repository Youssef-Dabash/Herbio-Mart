
   @model HerbioMart.ViewModels.PatientProfile.PatientProfileVM

@{
    ViewData["Title"] = "Patient Profile";
}

<div class="container mt-4">
    <h2>Patient Profile</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card p-4 shadow-sm">
        <dl class="row">
            <dt class="col-sm-3">Full Name:</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Username:</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">Email:</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone Number:</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Address:</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">Birth Date:</dt>
            <dd class="col-sm-9">@Model.BirthDate?.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Gender:</dt>
            <dd class="col-sm-9">@Model.Gender</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Update" class="btn btn-primary">Edit Information</a>
            
            <!-- زر الحذف مع تنبيه تأكيد -->
            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate your account?');">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>
</div>