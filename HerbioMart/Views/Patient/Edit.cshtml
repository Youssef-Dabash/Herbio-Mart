@model HerbioMart.ViewModels.Patient.EditPatientProfileVM

@{
    ViewData["Title"] = "Edit Personal Information";
    var userInitial = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Trim()[0].ToString().ToUpper() : "P";
}

<style>
    .edit-patient-wrapper {
        margin-top: 155px;
        margin-bottom: 60px;
    }

    .edit-profile-card {
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
        max-width: 850px;
        margin: 0 auto;
    }

    .status-pill-badge {
        display: inline-block;
        background-color: #dcfce7 !important;
        color: #15803d !important;
        border: 1px solid #86efac;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 6px 18px;
        border-radius: 50px;
        letter-spacing: 0.3px;
    }

    .avatar-preview-box {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        background-color: #2e7d32;
        color: #ffffff;
        font-size: 2.2rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #81c784;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        flex-shrink: 0;
    }

    .avatar-preview-img {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #81c784;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        flex-shrink: 0;
    }

    .section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #15803d;
        border-bottom: 2px solid #f0fdf4;
        padding-bottom: 8px;
        margin-bottom: 16px;
    }
</style>

<div class="container edit-patient-wrapper">
    <div class="card edit-profile-card p-4 p-md-5">

        <!-- Header -->
        <div class="text-center mb-4">
            <div class="status-pill-badge mb-2">
                <i class="fas fa-user-edit me-1"></i> Patient Account Management
            </div>
            <h2 class="fw-bold text-dark mb-1">Edit Personal Information</h2>
            <p class="text-muted small mb-0">Update your clinical identity, contact details, and account photo.</p>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Profile Picture Section -->
            <div class="bg-light p-3 rounded-4 border mb-4 d-flex flex-column flex-sm-row align-items-center gap-3">
                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                {
                    <img src="@Model.ExistingImageUrl" alt="@Model.FullName" class="avatar-preview-img" />
                }
                else
                {
                    <div class="avatar-preview-box">
                        @userInitial
                    </div>
                }

                <div class="flex-grow-1 text-center text-sm-start">
                    <label class="form-label fw-bold text-dark mb-1">Profile Photo</label>
                    <input asp-for="ProfileImage" type="file" accept="image/*" class="form-control form-control-sm rounded-3" />
                    <small class="text-muted d-block mt-1">Upload a JPG, PNG or WEBP image to display beside your name.</small>
                    <span asp-validation-for="ProfileImage" class="text-danger small"></span>
                </div>
            </div>

            <!-- 1. Identity & Clinical Demographics -->
            <div class="section-title">
                <i class="fas fa-id-card me-1"></i> Identity & Demographics
            </div>

            <div class="row g-3 mb-4">
                <!-- Full Name -->
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold text-dark">Full Legal Name</label>
                    <input asp-for="FullName" class="form-control rounded-3" placeholder="Mohammed Ibrahim" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <!-- Phone -->
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-semibold text-dark">Mobile Phone Number</label>
                    <input asp-for="Phone" class="form-control rounded-3" placeholder="010xxxxxxxx" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <!-- Birth Date -->
                <div class="col-md-6">
                    <label asp-for="BirthDate" class="form-label fw-semibold text-dark">Birth Date</label>
                    <input asp-for="BirthDate" type="date" class="form-control rounded-3"
                           value="@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                </div>

                <!-- Gender -->
                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label fw-semibold text-dark">Gender</label>
                    <select asp-for="Gender" class="form-select rounded-3">
                        <option value="">Choose Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
            </div>

            <!-- 2. Residential Address -->
            <div class="section-title">
                <i class="fas fa-map-marked-alt me-1"></i> Residential Address
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Governorate" class="form-label fw-semibold text-dark">Governorate</label>
                    <input asp-for="Governorate" class="form-control rounded-3" placeholder="Menoufia" />
                    <span asp-validation-for="Governorate" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="City" class="form-label fw-semibold text-dark">City / District</label>
                    <input asp-for="City" class="form-control rounded-3" placeholder="Menouf" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Street" class="form-label fw-semibold text-dark">Street / Address Details</label>
                    <input asp-for="Street" class="form-control rounded-3" placeholder="Tita, Menouf" />
                    <span asp-validation-for="Street" class="text-danger small"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                <a asp-action="Profile" class="btn btn-light rounded-pill px-4 py-2 text-muted fw-semibold">
                    Cancel
                </a>
                <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow-sm">
                    <i class="fas fa-save me-1"></i> Save Changes
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}