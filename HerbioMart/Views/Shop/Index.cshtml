@{
    ViewData["Title"] = "Remedies & Herbal Catalog";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Herbal Catalog</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item active text-white">Shop Catalog</li>
    </ol>
</div>
<!-- Single Page Header End -->
<!-- Fruits Shop Start-->
<div class="container-fluid fruite py-5">
    <div class="container py-5">
        <h1 class="mb-4">Natural Herbs & Formulated Remedies</h1>
        <div class="row g-4">
            <div class="col-lg-12">
                <!-- Search & Sort Controls -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-4">
                        <form asp-controller="Shop" asp-action="Index" method="get">
                            <div class="input-group w-100 mx-auto d-flex">
                                <input type="search" name="searchQuery" class="form-control p-3" placeholder="Search by herb, recipe or symptom...">
                                <button type="submit" class="input-group-text p-3 bg-primary text-white border-0"><i class="fa fa-search"></i></button>
                            </div>
                        </form>
                    </div>
                    <div class="col-xl-5"></div>
                    <div class="col-xl-3">
                        <div class="bg-light ps-3 py-3 rounded d-flex justify-content-between align-items-center">
                            <label for="sorting" class="mb-0 small fw-semibold">Sort By:</label>
                            <select id="sorting" name="sortBy" class="border-0 form-select-sm bg-light me-3">
                                <option value="latest">Latest Additions</option>
                                <option value="popularity">Most Popular</option>
                                <option value="priceAsc">Price: Low to High</option>
                                <option value="priceDesc">Price: High to Low</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Sidebar Filters -->
                    <div class="col-lg-3">
                        <div class="row g-4">
                            <!-- Condition / Disease Filter -->
                            <div class="col-lg-12">
                                <div class="mb-3">
                                    <h4 class="fw-bold mb-3">Health Conditions</h4>
                                    <ul class="list-unstyled fruite-categorie">
                                        <li>
                                            <div class="d-flex justify-content-between fruite-name">
                                                <a asp-controller="Shop" asp-action="Index" asp-route-disease="Hypertension">
                                                    <i class="fas fa-heartbeat me-2 text-danger"></i>Hypertension
                                                </a>
                                                <span>(12)</span>
                                            </div>
                                        </li>
                                        <li>
                                            <div class="d-flex justify-content-between fruite-name">
                                                <a asp-controller="Shop" asp-action="Index" asp-route-disease="Diabetes">
                                                    <i class="fas fa-tint me-2 text-primary"></i>Diabetes
                                                </a>
                                                <span>(9)</span>
                                            </div>
                                        </li>
                                        <li>
                                            <div class="d-flex justify-content-between fruite-name">
                                                <a asp-controller="Shop" asp-action="Index" asp-route-disease="Asthma">
                                                    <i class="fas fa-lungs me-2 text-info"></i>Asthma & Chest
                                                </a>
                                                <span>(6)</span>
                                            </div>
                                        </li>
                                        <li>
                                            <div class="d-flex justify-content-between fruite-name">
                                                <a asp-controller="Shop" asp-action="Index" asp-route-disease="Digestive">
                                                    <i class="fas fa-shield-virus me-2 text-warning"></i>IBS & Digestion
                                                </a>
                                                <span>(15)</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Price Range Filter -->
                            <div class="col-lg-12">
                                <div class="mb-3">
                                    <h4 class="mb-2 fw-bold">Max Price (EGP)</h4>
                                    <input type="range" class="form-range w-100" id="rangeInput" name="rangeInput" min="0" max="500" value="250" oninput="amount.value=rangeInput.value">
                                    <output id="amount" name="amount" for="rangeInput" class="fw-bold text-primary">250</output> <span>EGP</span>
                                </div>
                            </div>

                            <!-- Remedy Classification -->
                            <div class="col-lg-12">
                                <div class="mb-3">
                                    <h4 class="fw-bold mb-2">Item Type</h4>
                                    <div class="mb-2">
                                        <input type="radio" class="me-2" id="Type-All" name="itemType" value="All" checked>
                                        <label for="Type-All">All Catalog</label>
                                    </div>
                                    <div class="mb-2">
                                        <input type="radio" class="me-2" id="Type-Recipes" name="itemType" value="Recipes">
                                        <label for="Type-Recipes">Formulated Recipes</label>
                                    </div>
                                    <div class="mb-2">
                                        <input type="radio" class="me-2" id="Type-Herbs" name="itemType" value="SingleHerbs">
                                        <label for="Type-Herbs">Single Herbs</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Featured Formulations Sidebar -->
                            <div class="col-lg-12">
                                <h4 class="mb-3 fw-bold">Top Formulations</h4>
                                <div class="d-flex align-items-center justify-content-start mb-3">
                                    <div class="rounded me-4" style="width: 80px; height: 80px;">
                                        <img src="~/img/featur-1.jpg" class="img-fluid rounded" alt="Digestive Tea">
                                    </div>
                                    <div>
                                        <h6 class="mb-1">Digestive Blend</h6>
                                        <div class="d-flex mb-1 text-primary small">
                                            <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                                        </div>
                                        <div class="d-flex">
                                            <h6 class="fw-bold me-2">120.00 EGP</h6>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-start mb-3">
                                    <div class="rounded me-4" style="width: 80px; height: 80px;">
                                        <img src="~/img/featur-2.jpg" class="img-fluid rounded" alt="Chamomile Flowers">
                                    </div>
                                    <div>
                                        <h6 class="mb-1">Raw Chamomile</h6>
                                        <div class="d-flex mb-1 text-primary small">
                                            <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star text-muted"></i>
                                        </div>
                                        <div class="d-flex">
                                            <h6 class="fw-bold me-2">45.00 EGP</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Catalog Items Grid -->
                    <div class="col-lg-9">
                        <div class="row g-4 justify-content-center">
                            <!-- Card 1: Recipe -->
                            <div class="col-md-6 col-lg-6 col-xl-4">
                                <div class="rounded position-relative fruite-item border border-secondary h-100 d-flex flex-column">
                                    <div class="fruite-img">
                                        <img src="~/img/fruite-item-5.jpg" class="img-fluid w-100 rounded-top" alt="Digestive Compound">
                                    </div>
                                    <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Recipe</div>
                                    <div class="p-4 border-top-0 rounded-bottom d-flex flex-column flex-grow-1">
                                        <h4>Digestive Soothe</h4>
                                        <p class="text-muted small flex-grow-1">Compound mixture formulated for irritable bowel and stomach relief.</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <p class="text-dark fs-5 fw-bold mb-0">120.00 EGP</p>
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="1" class="btn border border-secondary rounded-pill px-3 text-primary">
                                                <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: Single Herb -->
                            <div class="col-md-6 col-lg-6 col-xl-4">
                                <div class="rounded position-relative fruite-item border border-secondary h-100 d-flex flex-column">
                                    <div class="fruite-img">
                                        <img src="~/img/fruite-item-2.jpg" class="img-fluid w-100 rounded-top" alt="Chamomile Flowers">
                                    </div>
                                    <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Single Herb</div>
                                    <div class="p-4 border-top-0 rounded-bottom d-flex flex-column flex-grow-1">
                                        <h4>Chamomile Pack</h4>
                                        <p class="text-muted small flex-grow-1">Pure sun-dried organic chamomile flowers for anxiety and sleep support.</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <p class="text-dark fs-5 fw-bold mb-0">45.00 EGP</p>
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="2" class="btn border border-secondary rounded-pill px-3 text-primary">
                                                <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 3: Recipe -->
                            <div class="col-md-6 col-lg-6 col-xl-4">
                                <div class="rounded position-relative fruite-item border border-secondary h-100 d-flex flex-column">
                                    <div class="fruite-img">
                                        <img src="~/img/fruite-item-4.jpg" class="img-fluid w-100 rounded-top" alt="Cardio Care Blend">
                                    </div>
                                    <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Recipe</div>
                                    <div class="p-4 border-top-0 rounded-bottom d-flex flex-column flex-grow-1">
                                        <h4>Cardio-Tonic Mix</h4>
                                        <p class="text-muted small flex-grow-1">Traditional hawthorn and hibiscus mix supporting normal blood pressure.</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <p class="text-dark fs-5 fw-bold mb-0">150.00 EGP</p>
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="3" class="btn border border-secondary rounded-pill px-3 text-primary">
                                                <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 4: Single Herb -->
                            <div class="col-md-6 col-lg-6 col-xl-4">
                                <div class="rounded position-relative fruite-item border border-secondary h-100 d-flex flex-column">
                                    <div class="fruite-img">
                                        <img src="~/img/fruite-item-1.jpg" class="img-fluid w-100 rounded-top" alt="Ginger Root">
                                    </div>
                                    <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Single Herb</div>
                                    <div class="p-4 border-top-0 rounded-bottom d-flex flex-column flex-grow-1">
                                        <h4>Dried Ginger Root</h4>
                                        <p class="text-muted small flex-grow-1">Crushed organic ginger powder for joint support and circulation.</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <p class="text-dark fs-5 fw-bold mb-0">55.00 EGP</p>
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="4" class="btn border border-secondary rounded-pill px-3 text-primary">
                                                <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 5: Recipe -->
                            <div class="col-md-6 col-lg-6 col-xl-4">
                                <div class="rounded position-relative fruite-item border border-secondary h-100 d-flex flex-column">
                                    <div class="fruite-img">
                                        <img src="~/img/fruite-item-3.jpg" class="img-fluid w-100 rounded-top" alt="Respiratory Blend">
                                    </div>
                                    <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Recipe</div>
                                    <div class="p-4 border-top-0 rounded-bottom d-flex flex-column flex-grow-1">
                                        <h4>Chest Clarifier</h4>
                                        <p class="text-muted small flex-grow-1">Thyme and licorice infusion for easing coughs and respiratory allergies.</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <p class="text-dark fs-5 fw-bold mb-0">95.00 EGP</p>
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="5" class="btn border border-secondary rounded-pill px-3 text-primary">
                                                <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 6: Single Herb -->
                            <div class="col-md-6 col-lg-6 col-xl-4">
                                <div class="rounded position-relative fruite-item border border-secondary h-100 d-flex flex-column">
                                    <div class="fruite-img">
                                        <img src="~/img/fruite-item-5.jpg" class="img-fluid w-100 rounded-top" alt="Peppermint Leaves">
                                    </div>
                                    <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Single Herb</div>
                                    <div class="p-4 border-top-0 rounded-bottom d-flex flex-column flex-grow-1">
                                        <h4>Peppermint Leaves</h4>
                                        <p class="text-muted small flex-grow-1">Freshly harvested peppermint leaves for spasms and calming teas.</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <p class="text-dark fs-5 fw-bold mb-0">35.00 EGP</p>
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="6" class="btn border border-secondary rounded-pill px-3 text-primary">
                                                <i class="fa fa-info-circle me-1 text-primary"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pagination -->
                            <div class="col-12">
                                <div class="pagination d-flex justify-content-center mt-5">
                                    <a asp-controller="Shop" asp-action="Index" asp-route-page="1" class="rounded">&laquo;</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-page="1" class="active rounded">1</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-page="2" class="rounded">2</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-page="3" class="rounded">3</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-page="2" class="rounded">&raquo;</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fruits Shop End-->