@model HerbioMart.ViewModels.Recipes.RecipeDetailsVM

@{
    ViewData["Title"] = Model.RecipeName + " - Details";
}

<style>
    .badge-disease-pill {
        border: 1px solid #fca5a5;
        color: #dc2626;
        background-color: #fef2f2;
        font-weight: 600;
        border-radius: 50rem;
        padding: 0.35rem 0.85rem;
        font-size: 0.8rem;
        display: inline-block;
    }
</style>

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Remedy Details</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-white">Catalog</a></li>
        <li class="breadcrumb-item active text-white">@Model.RecipeName</li>
    </ol>
</div>
<!-- Single Page Header End -->

<div class="container-fluid py-5">
    <div class="container py-4">
        <div class="row g-4 mb-5">
            <div class="col-lg-8 col-xl-9">
                <div class="row g-4">

                    <!-- Remedy Image Placeholder / Icon Container -->
                    <div class="col-lg-6">
                        <div class="border rounded-4 position-relative overflow-hidden shadow-sm bg-light d-flex align-items-center justify-content-center" style="height: 380px;">
                            <img src="~/img/single-item.jpg" class="img-fluid w-100 h-100 rounded-4" style="object-fit: cover;" alt="@Model.RecipeName" />
                            <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                <i class="fas fa-mortar-pestle me-1"></i> Formulated Recipe
                            </span>
                        </div>
                    </div>

                    <!-- Core Info & Add to Cart -->
                    <div class="col-lg-6">
                        <h3 class="fw-bold mb-2 text-dark">@Model.RecipeName</h3>

                        <p class="mb-2 text-muted small">
                            Compounded By: <strong class="text-success">@Model.HerbalistName</strong>
                        </p>

                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <h3 class="fw-bold text-dark font-monospace mb-0">@Model.Price.ToString("0.00")</h3>
                            <span class="text-muted fw-bold">EGP</span>
                        </div>

                        <!-- Live Rating Summary -->
                        <div class="d-flex align-items-center mb-3">
                            <div class="text-warning small me-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.AverageRating))
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted"></i>
                                    }
                                }
                            </div>
                            <span class="fw-bold text-dark font-monospace me-1">@Model.AverageRating.ToString("0.0")</span>
                            <span class="text-muted small">(@Model.TotalRatings Reviews)</span>
                        </div>

                        <!-- Targeted Diseases Badges -->
                        <div class="mb-3">
                            <small class="text-muted fw-bold d-block mb-1">TARGETED CONDITIONS:</small>
                            <div class="d-flex flex-wrap gap-1">
                                @if (Model.TargetedDiseases.Any())
                                {
                                    @foreach (var disease in Model.TargetedDiseases)
                                    {
                                        <span class="badge-disease-pill">@disease</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge-disease-pill">General Wellness</span>
                                }
                            </div>
                        </div>

                        <p class="mb-4 text-muted small" style="line-height: 1.6;">
                            @Model.Description
                        </p>

                        <!-- Add to Cart Form -->
                        <form asp-controller="Cart" asp-action="AddRecipeToCart" method="post">
                            <input type="hidden" name="recipeId" value="@Model.RecipeId" />
                            <input type="hidden" name="recipeName" value="@Model.RecipeName" />
                            <input type="hidden" name="herbalistName" value="@Model.HerbalistName" />
                            <input type="hidden" name="price" value="@Model.Price" />

                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="input-group" style="width: 130px;">
                                    <button class="btn btn-light border px-3" type="button" id="btnMinus">
                                        <i class="fa fa-minus small"></i>
                                    </button>
                                    <input type="number" id="qtyInput" name="quantity" class="form-control text-center fw-bold" value="1" min="1" max="50">
                                    <button class="btn btn-light border px-3" type="button" id="btnPlus">
                                        <i class="fa fa-plus small"></i>
                                    </button>
                                </div>

                                <button type="submit" class="btn btn-success rounded-pill px-4 py-2 text-white fw-semibold shadow-sm">
                                    <i class="fas fa-shopping-basket me-2"></i> Add To Cart
                                </button>
                            </div>
                        </form>

                        <div class="d-flex gap-2">
                            <a asp-controller="Feedback" asp-action="Create" asp-route-recipeId="@Model.RecipeId" class="btn btn-outline-success rounded-pill btn-sm px-3 fw-semibold">
                                <i class="fas fa-star me-1"></i> Review This Remedy
                            </a>
                        </div>
                    </div>

                    <!-- Instructions & Ingredients Tabs -->
                    <div class="col-lg-12 mt-4">
                        <nav>
                            <div class="nav nav-tabs mb-3" id="nav-tab" role="tablist">
                                <button class="nav-link active fw-semibold" id="nav-instructions-tab" data-bs-toggle="tab" data-bs-target="#nav-instructions" type="button" role="tab">
                                    Preparation & Instructions
                                </button>
                                <button class="nav-link fw-semibold" id="nav-ingredients-tab" data-bs-toggle="tab" data-bs-target="#nav-ingredients" type="button" role="tab">
                                    Blend Composition (@Model.Ingredients.Count)
                                </button>
                            </div>
                        </nav>

                        <div class="tab-content border rounded-4 p-4 bg-white shadow-sm mb-5" id="nav-tabContent">

                            <!-- Tab 1: Instructions -->
                            <div class="tab-pane fade show active" id="nav-instructions" role="tabpanel">
                                <h5 class="fw-bold mb-2 text-success">
                                    <i class="fas fa-prescription me-1"></i> Usage Instructions & Clinical Guidance
                                </h5>
                                <p class="text-muted mb-0" style="line-height: 1.8;">
                                    @(string.IsNullOrWhiteSpace(Model.Instructions)
                                        ? "Take as advised by your apothecary or consulting physician."
                                        : Model.Instructions)
                                </p>
                            </div>

                            <!-- Tab 2: Composition Table -->
                            <div class="tab-pane fade" id="nav-ingredients" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-bordered align-middle mb-0">
                                        <thead class="table-light small text-uppercase">
                                            <tr>
                                                <th>Constituent Herb</th>
                                                <th>Quantity / Weight</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Ingredients.Any())
                                            {
                                                @foreach (var ing in Model.Ingredients)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold text-dark">
                                                            <i class="fas fa-leaf text-success me-2"></i>@ing.HerbName
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-light text-dark border px-3 py-2">
                                                                @ing.AmountInGrams Grams
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="2" class="text-center text-muted py-3">Proprietary composition details not disclosed.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="fas fa-shield-alt text-success me-2"></i>HerbioMart Guarantee
                    </h5>
                    <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-2">
                        <li><i class="fas fa-check-circle text-success me-2"></i>Formulated by certified botanical herbalists.</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>100% natural, laboratory-tested constituents.</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Direct dispatch from licensed apothecary stores.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnMinus').addEventListener('click', function() {
            var input = document.getElementById('qtyInput');
            var val = parseInt(input.value) || 1;
            if (val > 1) input.value = val - 1;
        });

        document.getElementById('btnPlus').addEventListener('click', function() {
            var input = document.getElementById('qtyInput');
            var val = parseInt(input.value) || 1;
            if (val < 50) input.value = val + 1;
        });
    </script>
}