@{
    ViewData["Title"] = "Remedy Details";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Remedy Details</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-white">Catalog</a></li>
        <li class="breadcrumb-item active text-white">Details</li>
    </ol>
</div>
<!-- Single Page Header End -->
<!-- Single Product Start -->
<div class="container-fluid py-5 mt-5">
    <div class="container py-5">
        <div class="row g-4 mb-5">
            <div class="col-lg-8 col-xl-9">
                <div class="row g-4">
                    <!-- Product Image -->
                    <div class="col-lg-6">
                        <div class="border rounded position-relative">
                            <img src="~/img/single-item.jpg" class="img-fluid rounded w-100" alt="Digestive Soothe Compound">
                            <span class="badge bg-secondary position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">Formulated Recipe</span>
                        </div>
                    </div>

                    <!-- Core Remedy Info & Add to Cart -->
                    <div class="col-lg-6">
                        <h4 class="fw-bold mb-2 text-dark">Digestive Relief Compound</h4>
                        <p class="mb-2 text-muted small">
                            Prepared By: <span class="text-primary fw-semibold">Al-Azhar Apothecary (Lic: #EG-8841)</span>
                        </p>
                        <h5 class="fw-bold mb-3 text-primary">120.00 EGP</h5>

                        <div class="d-flex align-items-center mb-3 text-primary">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                            <span class="text-muted ms-2 small">(24 Patient Reviews)</span>
                        </div>

                        <p class="mb-4 text-muted">
                            A standardized synergistic blend of pure dried chamomile, peppermint leaves, and crushed fennel seeds formulated to ease gastrointestinal discomfort, bloating, and acute digestive spasms.
                        </p>

                        <!-- Dosage Highlight -->
                        <div class="alert alert-light border rounded-3 p-3 mb-4">
                            <small class="fw-bold text-dark d-block mb-1"><i class="fas fa-prescription me-1 text-primary"></i> Recommended Dosage:</small>
                            <span class="small text-muted">Steep 1 tablespoon in 200ml boiling water for 10 minutes. Consume twice daily after main meals.</span>
                        </div>

                        <form asp-controller="Cart" asp-action="Index" method="post">
                            <input type="hidden" name="itemId" value="1" />
                            <input type="hidden" name="itemType" value="Recipe" />

                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="input-group quantity" style="width: 120px;">
                                    <div class="input-group-btn">
                                        <button class="btn btn-sm btn-minus rounded-circle bg-light border" type="button">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                    </div>
                                    <input type="text" name="quantity" class="form-control form-control-sm text-center border-0" value="1">
                                    <div class="input-group-btn">
                                        <button class="btn btn-sm btn-plus rounded-circle bg-light border" type="button">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="submit" class="btn border border-secondary rounded-pill px-4 py-2 text-primary fw-semibold">
                                    <i class="fa fa-shopping-bag me-2 text-primary"></i> Add To Cart
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Product Specifications & Reviews Tabs -->
                    <div class="col-lg-12 mt-5">
                        <nav>
                            <div class="nav nav-tabs mb-3" id="nav-tab" role="tablist">
                                <button class="nav-link active border-white border-bottom-0 fw-semibold" id="nav-desc-tab" data-bs-toggle="tab" data-bs-target="#nav-desc" type="button" role="tab">
                                    Clinical Description & Safety
                                </button>
                                <button class="nav-link border-white border-bottom-0 fw-semibold" id="nav-ingredients-tab" data-bs-toggle="tab" data-bs-target="#nav-ingredients" type="button" role="tab">
                                    Recipe Composition
                                </button>
                                <button class="nav-link border-white border-bottom-0 fw-semibold" id="nav-reviews-tab" data-bs-toggle="tab" data-bs-target="#nav-reviews" type="button" role="tab">
                                    Patient Feedback (2)
                                </button>
                            </div>
                        </nav>
                        <div class="tab-content mb-5" id="nav-tabContent">
                            <!-- Tab 1: Description -->
                            <div class="tab-pane active" id="nav-desc" role="tabpanel">
                                <h5 class="fw-bold mb-2">Therapeutic Indications</h5>
                                <p class="text-muted">
                                    Engineered primarily for easing spastic colon irritability and non-ulcer dyspepsia. The volatile oils contained within the composite herbs soothe smooth muscle tissues within the intestinal walls.
                                </p>

                                <h5 class="fw-bold mt-4 mb-2 text-danger"><i class="fas fa-exclamation-circle me-1"></i> Medical Contraindications & Warnings</h5>
                                <p class="text-muted mb-0">
                                    Do not consume during the first trimester of pregnancy. Avoid simultaneous intake with strong sedative drugs without prior physician consultation. Keep dry in an airtight jar away from direct sunlight.
                                </p>
                            </div>

                            <!-- Tab 2: Composition -->
                            <div class="tab-pane" id="nav-ingredients" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Constituent Herb</th>
                                                <th>Scientific Botanical Name</th>
                                                <th>Net Weight / Proportion</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Dried Chamomile Blossoms</td>
                                                <td><em>Matricaria chamomilla</em></td>
                                                <td>50 grams</td>
                                            </tr>
                                            <tr>
                                                <td>Organic Peppermint Cut Leaves</td>
                                                <td><em>Mentha piperita</em></td>
                                                <td>30 grams</td>
                                            </tr>
                                            <tr>
                                                <td>Fennel Whole Seeds</td>
                                                <td><em>Foeniculum vulgare</em></td>
                                                <td>20 grams</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Tab 3: Reviews -->
                            <div class="tab-pane" id="nav-reviews" role="tabpanel">
                                <div class="d-flex mb-4">
                                    <img src="~/img/avatar.jpg" class="img-fluid rounded-circle p-2" style="width: 80px; height: 80px;" alt="Patient">
                                    <div class="ms-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="mb-0 fw-bold">Dr. Mahmoud Saber</h6>
                                            <span class="text-muted small">May 14, 2026</span>
                                        </div>
                                        <div class="d-flex text-primary mb-2 small">
                                            <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                                        </div>
                                        <p class="text-muted small mb-0">
                                            Very clean formulation. The seal was airtight and the aroma confirms freshness of the harvest. Highly recommended for post-prandial heaviness.
                                        </p>
                                    </div>
                                </div>
                                <hr class="text-muted" />
                                <div class="d-flex mb-4">
                                    <img src="~/img/avatar.jpg" class="img-fluid rounded-circle p-2" style="width: 80px; height: 80px;" alt="Patient">
                                    <div class="ms-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="mb-0 fw-bold">Mariam Adel</h6>
                                            <span class="text-muted small">June 02, 2026</span>
                                        </div>
                                        <div class="d-flex text-primary mb-2 small">
                                            <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star text-muted"></i>
                                        </div>
                                        <p class="text-muted small mb-0">
                                            Arrived neatly packaged within 48 hours. Clear dosage label on the packet.
                                        </p>
                                    </div>
                                </div>

                                <!-- Post Feedback Form -->
                                <form asp-controller="Shop" asp-action="Details" method="post" class="mt-5 border-top pt-4">
                                    <h5 class="fw-bold mb-3">Leave a Patient Evaluation</h5>
                                    <div class="row g-4">
                                        <div class="col-lg-6">
                                            <input type="text" name="PatientName" class="form-control" placeholder="Your Name *" required>
                                        </div>
                                        <div class="col-lg-6">
                                            <select name="RatingValue" class="form-select">
                                                <option value="5">5 Stars - Excellent Result</option>
                                                <option value="4">4 Stars - Good Efficacy</option>
                                                <option value="3">3 Stars - Average</option>
                                                <option value="2">2 Stars - Minimal Effect</option>
                                                <option value="1">1 Star - Unsatisfactory</option>
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <textarea name="Comment" class="form-control" rows="4" placeholder="Detail your health results or remedy evaluation *" required></textarea>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn border border-secondary text-primary rounded-pill px-4 py-2 fw-semibold">
                                                Post Feedback
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4 col-xl-3">
                <div class="row g-4 fruite">
                    <div class="col-lg-12">
                        <!-- Search widget -->
                        <form asp-controller="Shop" asp-action="Index" method="get">
                            <div class="input-group w-100 mx-auto d-flex mb-4">
                                <input type="search" name="searchQuery" class="form-control p-3" placeholder="Search catalog...">
                                <button type="submit" class="input-group-text p-3 bg-primary text-white border-0"><i class="fa fa-search"></i></button>
                            </div>
                        </form>

                        <!-- Disease Categories -->
                        <div class="mb-4">
                            <h4 class="fw-bold mb-3">Related Conditions</h4>
                            <ul class="list-unstyled fruite-categorie">
                                <li>
                                    <div class="d-flex justify-content-between fruite-name">
                                        <a asp-controller="Shop" asp-action="Index" asp-route-disease="Digestive"><i class="fas fa-notes-medical me-2"></i>IBS & Digestion</a>
                                        <span>(15)</span>
                                    </div>
                                </li>
                                <li>
                                    <div class="d-flex justify-content-between fruite-name">
                                        <a asp-controller="Shop" asp-action="Index" asp-route-disease="Hypertension"><i class="fas fa-notes-medical me-2"></i>Hypertension</a>
                                        <span>(12)</span>
                                    </div>
                                </li>
                                <li>
                                    <div class="d-flex justify-content-between fruite-name">
                                        <a asp-controller="Shop" asp-action="Index" asp-route-disease="Diabetes"><i class="fas fa-notes-medical me-2"></i>Diabetes Care</a>
                                        <span>(9)</span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Sidebar Featured -->
                    <div class="col-lg-12">
                        <h4 class="mb-3 fw-bold">Popular Remedies</h4>
                        <div class="d-flex align-items-center justify-content-start mb-3">
                            <div class="rounded me-3" style="width: 80px; height: 80px;">
                                <img src="~/img/featur-1.jpg" class="img-fluid rounded" alt="Chamomile">
                            </div>
                            <div>
                                <h6 class="mb-1">Organic Chamomile</h6>
                                <p class="fw-bold mb-0 text-primary">45.00 EGP</p>
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="2" class="small text-muted text-decoration-underline">View Details</a>
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-start mb-3">
                            <div class="rounded me-3" style="width: 80px; height: 80px;">
                                <img src="~/img/featur-2.jpg" class="img-fluid rounded" alt="Cardio Mix">
                            </div>
                            <div>
                                <h6 class="mb-1">Cardio-Tonic Mix</h6>
                                <p class="fw-bold mb-0 text-primary">150.00 EGP</p>
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="3" class="small text-muted text-decoration-underline">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Remedies Carousel -->
        <h2 class="fw-bold mb-4">Related Formulations</h2>
        <div class="vesitable">
            <div class="owl-carousel vegetable-carousel justify-content-center">
                <div class="border border-primary rounded position-relative vesitable-item p-3 bg-white">
                    <div class="vesitable-img mb-3">
                        <img src="~/img/vegetable-item-6.jpg" class="img-fluid w-100 rounded" alt="Peppermint">
                    </div>
                    <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 20px; right: 20px;">Single Herb</div>
                    <h5 class="fw-bold">Dried Mint Leaves</h5>
                    <p class="text-muted small mb-3">Carminative and spasm-reducing infusion herb.</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-dark fw-bold">35.00 EGP</span>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="6" class="btn border border-secondary rounded-pill px-3 py-1 text-primary">
                            Details
                        </a>
                    </div>
                </div>

                <div class="border border-primary rounded position-relative vesitable-item p-3 bg-white">
                    <div class="vesitable-img mb-3">
                        <img src="~/img/vegetable-item-1.jpg" class="img-fluid w-100 rounded" alt="Thyme">
                    </div>
                    <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 20px; right: 20px;">Recipe</div>
                    <h5 class="fw-bold">Chest Clarifier</h5>
                    <p class="text-muted small mb-3">Thyme and licorice infusion for chronic coughs.</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-dark fw-bold">95.00 EGP</span>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="5" class="btn border border-secondary rounded-pill px-3 py-1 text-primary">
                            Details
                        </a>
                    </div>
                </div>

                <div class="border border-primary rounded position-relative vesitable-item p-3 bg-white">
                    <div class="vesitable-img mb-3">
                        <img src="~/img/vegetable-item-3.png" class="img-fluid w-100 rounded" alt="Ginger">
                    </div>
                    <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 20px; right: 20px;">Single Herb</div>
                    <h5 class="fw-bold">Crushed Ginger Root</h5>
                    <p class="text-muted small mb-3">Pure natural circulation booster and anti-inflammatory.</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-dark fw-bold">55.00 EGP</span>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="4" class="btn border border-secondary rounded-pill px-3 py-1 text-primary">
                            Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Single Product End -->