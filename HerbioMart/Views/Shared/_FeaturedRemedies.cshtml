@model HerbioMart.ViewModels.Home.HomeIndexVM

<style>
    .home-herb-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        overflow: hidden;
    }

        .home-herb-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
        }

    .home-herb-img {
        position: relative;
        height: 200px;
        background-color: #f8fafc;
        overflow: hidden;
    }

        .home-herb-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .home-herb-card:hover .home-herb-img img {
        transform: scale(1.05);
    }

    .home-recipe-card {
        border-radius: 16px;
        border: 1px solid #e9ecef;
        border-top: 4px solid #198754;
        background: #ffffff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .home-recipe-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(25, 135, 84, 0.1);
        }

    .badge-disease {
        border: 1px solid #f87171;
        color: #dc2626;
        background-color: #fef2f2;
        font-weight: 500;
        border-radius: 50rem;
        padding: 0.25rem 0.65rem;
        font-size: 0.72rem;
    }
</style>

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
            <div>
                <h1 class="display-5 fw-bold text-dark mb-1">Featured Remedies</h1>
                <p class="text-muted mb-0">Explore verified botanical herbs and master apothecary formulations.</p>
            </div>

            <ul class="nav nav-pills bg-light p-1 rounded-pill border d-inline-flex" id="featuredTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4 py-2 fw-semibold" id="tab-herbs-btn" data-bs-toggle="pill" data-bs-target="#tab-herbs" type="button" role="tab">
                        <i class="fas fa-leaf text-success me-2"></i> Raw Herbs (@Model.FeaturedHerbs.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 fw-semibold" id="tab-recipes-btn" data-bs-toggle="pill" data-bs-target="#tab-recipes" type="button" role="tab">
                        <i class="fas fa-mortar-pestle text-primary me-2"></i> Prepared Recipes (@Model.FeaturedRecipes.Count)
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="featuredTabsContent">

            <!-- 1. HERBS TAB -->
            <div class="tab-pane fade show active" id="tab-herbs" role="tabpanel">
                @if (!Model.FeaturedHerbs.Any())
                {
                    <div class="text-center py-5 bg-light rounded-4">
                        <p class="text-muted fw-semibold mb-0">No medicinal herbs available at the moment.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var herb in Model.FeaturedHerbs)
                        {
                            <div class="col-sm-6 col-md-6 col-lg-4 col-xl-3">
                                <div class="home-herb-card h-100 d-flex flex-column">
                                    <div class="home-herb-img">
                                        <img src="@herb.ImageUrl" alt="@herb.Name" />
                                        <span class="badge bg-success position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill small">
                                            <i class="fas fa-leaf me-1"></i> Herb
                                        </span>
                                    </div>

                                    <div class="p-3 d-flex flex-column flex-grow-1">
                                        <h5 class="fw-bold text-dark mb-1 text-truncate" title="@herb.Name">@herb.Name</h5>
                                        <p class="text-muted fst-italic small mb-2 text-truncate" style="font-size: 0.8rem;">
                                            @(string.IsNullOrWhiteSpace(herb.ScientificName) ? "Botanical Specimen" : herb.ScientificName)
                                        </p>

                                        <p class="text-muted small flex-grow-1 mb-3" style="font-size: 0.82rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                            @herb.Description
                                        </p>

                                        <div class="pt-2 border-top mt-auto">
                                            <a asp-controller="Herb" asp-action="Details" asp-route-id="@herb.Id" asp-route-type="Herb"
                                               class="btn btn-outline-success rounded-pill w-100 btn-sm fw-semibold py-2 d-flex align-items-center justify-content-center gap-1">
                                                <i class="fas fa-eye"></i> View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 2. RECIPES TAB -->
            <div class="tab-pane fade" id="tab-recipes" role="tabpanel">
                @if (!Model.FeaturedRecipes.Any())
                {
                    <div class="text-center py-5 bg-light rounded-4">
                        <p class="text-muted fw-semibold mb-0">No formulated recipes available at the moment.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var recipe in Model.FeaturedRecipes)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="home-recipe-card p-4 h-100 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="badge rounded-pill bg-light text-dark border px-3 py-2 fw-normal d-flex align-items-center">
                                            <i class="fas fa-user-check text-success me-2"></i> @recipe.HerbalistName
                                        </span>
                                        <div class="text-warning small d-flex align-items-center">
                                            <i class="fas fa-star me-1"></i>
                                            <span class="fw-bold text-dark">@recipe.Rating.ToString("0.0")</span>
                                            <span class="text-muted ms-1">(@recipe.ReviewCount)</span>
                                        </div>
                                    </div>

                                    <h4 class="fw-bold text-dark mb-3" style="font-size: 1.25rem;">
                                        @recipe.Name
                                    </h4>

                                    <div class="mb-3">
                                        <div class="d-flex align-items-center text-danger small fw-semibold mb-2">
                                            <i class="fas fa-heartbeat me-2"></i> Indicated For:
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (recipe.DiseasesTreated.Any())
                                            {
                                                @foreach (var dis in recipe.DiseasesTreated)
                                                {
                                                    <span class="badge-disease">@dis</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge-disease">Therapeutic Remedy</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="text-muted small mb-3">
                                        <i class="fas fa-leaf text-success me-2"></i> Proprietary blend of <strong>@(recipe.HerbsCount > 0 ? recipe.HerbsCount : 2)</strong> medicinal herbs
                                    </div>

                                    <p class="text-muted small flex-grow-1 mb-4" style="font-size: 0.82rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                        @recipe.Description
                                    </p>

                                    <div class="pt-3 border-top mt-auto d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.68rem; letter-spacing: 0.5px;">ESTIMATED PRICE</span>
                                            <span class="fs-4 fw-bold text-dark">@recipe.Price.ToString("F2")</span>
                                            <small class="text-muted fw-bold">EGP</small>
                                        </div>

                                        <span class="badge bg-success bg-opacity-10 text-white border border-success border-opacity-25 rounded-pill px-3 py-2 fw-semibold" style="font-size: 0.78rem;">
                                            <i class="fas fa-certificate me-1"></i> Formulated Blend
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>