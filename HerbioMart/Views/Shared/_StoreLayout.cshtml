@using HerbioMart.Models.Enums
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - HerbioMart</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/style.css" rel="stylesheet">
</head>

<body>
    <!-- Spinner Start -->
    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    <!-- Spinner End -->
    <!-- Navbar start -->
    <div class="container-fluid fixed-top">
        <div class="container topbar bg-primary d-none d-lg-block">
            <div class="d-flex justify-content-between">
                <div class="top-info ps-2">
                    <small class="me-3"><i class="fas fa-map-marker-alt me-2 text-secondary"></i> <span class="text-white">Cairo, Egypt</span></small>
                    <small class="me-3"><i class="fas fa-envelope me-2 text-secondary"></i><span class="text-white">support@herbiomart.com</span></small>
                </div>
                <div class="top-link pe-2">
                    <a asp-controller="Home" asp-action="Privacy" class="text-white"><small class="text-white mx-2">Privacy Policy</small>/</a>
                    <a asp-controller="Home" asp-action="Contact" class="text-white"><small class="text-white ms-2">Contact Support</small></a>
                </div>
            </div>
        </div>
        <div class="container px-0">
            <nav class="navbar navbar-light bg-white navbar-expand-xl">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                    <h1 class="text-primary display-6"><i class="fas fa-leaf text-success me-2"></i>HerbioMart</h1>
                </a>
                <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars text-primary"></span>
                </button>
                <div class="collapse navbar-collapse bg-white" id="navbarCollapse">
                    <div class="navbar-nav mx-auto">
                        <a asp-controller="Home" asp-action="Index" class="nav-item nav-link">Home</a>
                        <a asp-controller="Shop" asp-action="Index" class="nav-item nav-link">Shop Catalog</a>
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Explore</a>
                            <div class="dropdown-menu m-0 bg-secondary rounded-0">
                                <a asp-controller="Cart" asp-action="Index" class="dropdown-item">Cart</a>
                                <a asp-controller="Checkout" asp-action="Index" class="dropdown-item">Checkout</a>
                                <a asp-controller="Home" asp-action="Testimonials" class="dropdown-item">Testimonials</a>
                            </div>
                        </div>
                        <a asp-controller="Home" asp-action="Contact" class="nav-item nav-link">Contact</a>
                    </div>
                    <div class="d-flex m-3 me-0 align-items-center">
                        <button class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white me-4" data-bs-toggle="modal" data-bs-target="#searchModal">
                            <i class="fas fa-search text-primary"></i>
                        </button>
                        <a asp-controller="Cart" asp-action="Index" class="position-relative me-4 my-auto">
                            <i class="fa fa-shopping-bag fa-2x"></i>
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="nav-item dropdown my-auto">
                                <a href="#" class="dropdown-toggle text-dark d-flex align-items-center" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle fa-2x text-primary me-2"></i>
                                    <span class="fw-semibold small">@User.Identity.Name</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end m-0 bg-white shadow-sm rounded-3">
                                    @if (User.IsInRole("Herbalist"))
                                    {
                                        <a asp-controller="Herbalist" asp-action="Index" class="dropdown-item">
                                            <i class="fas fa-store me-2 text-success"></i> Herbalist Panel
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Patient" asp-action="Index" class="dropdown-item">
                                            <i class="fas fa-user-injured me-2 text-primary"></i> Patient Portal
                                        </a>
                                    }
                                    <hr class="dropdown-divider my-1">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                                            <i class="fas fa-sign-out-alt me-1"></i> Logout
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill px-3 py-1 my-auto">
                                <i class="fas fa-sign-in-alt me-1"></i> Login
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- Navbar End -->
    <!-- Modal Search Start -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h5 class="modal-title" id="searchModalLabel">Search Natural Herbs & Recipes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center">
                    <form asp-controller="Shop" asp-action="Index" method="get" class="w-75 mx-auto">
                        <div class="input-group">
                            <input type="search" name="searchQuery" class="form-control p-3" placeholder="Search by herb, recipe name, or symptoms..." aria-describedby="search-icon-1">
                            <button type="submit" class="input-group-text p-3 bg-primary text-white border-0"><i class="fa fa-search"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Search End -->
    <!-- Body Render -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer Start -->
    <div class="container-fluid bg-dark text-white-50 footer pt-5 mt-5">
        <div class="container py-5">
            <div class="pb-4 mb-4" style="border-bottom: 1px solid rgba(226, 175, 24, 0.5);">
                <div class="row g-4 align-items-center">
                    <div class="col-lg-4">
                        <a asp-controller="Home" asp-action="Index">
                            <h1 class="text-primary mb-0"><i class="fas fa-leaf text-success me-2"></i>HerbioMart</h1>
                            <p class="text-secondary mb-0">Certified Natural Herbs & Recipes</p>
                        </a>
                    </div>
                    <div class="col-lg-8 text-lg-end">
                        <small class="text-white">Connecting verified apothecaries with patient wellness needs.</small>
                    </div>
                </div>
            </div>
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-item">
                        <h4 class="text-light mb-3">About HerbioMart</h4>
                        <p class="mb-4">An advanced digital hub organizing traditional herbal treatments and linking them directly with diagnoses and certified practitioners.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex flex-column text-start footer-item">
                        <h4 class="text-light mb-3">Quick Links</h4>
                        <a class="btn-link" asp-controller="Shop" asp-action="Index">Store Catalog</a>
                        <a class="btn-link" asp-controller="Cart" asp-action="Index">My Prescription Cart</a>
                        <a class="btn-link" asp-controller="Home" asp-action="Contact">Contact & Inquiries</a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="footer-item">
                        <h4 class="text-light mb-3">Contact Support</h4>
                        <p>Address: Cairo, Egypt</p>
                        <p>Email: info@herbiomart.com</p>
                        <p>Phone: (+20) 010 1234 5678</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer End -->
    <!-- Copyright Start -->
    <div class="container-fluid copyright bg-dark py-4">
        <div class="container text-center">
            <span class="text-light">&copy; @DateTime.UtcNow.Year <a asp-controller="Home" asp-action="Index" class="text-primary">HerbioMart</a>, All rights reserved.</span>
        </div>
    </div>
    <!-- Copyright End -->

    <a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/lightbox/js/lightbox.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>