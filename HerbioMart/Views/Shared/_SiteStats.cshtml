@model HerbioMart.ViewModels.Home.SiteStatsVM

<div class="container-fluid py-5">
    <div class="container">
        <div class="bg-light p-5 rounded-4 shadow-sm border">
            <div class="row g-4 justify-content-center text-center">
                <!-- 1. Active Patients -->
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded-4 p-4 shadow-sm h-100 border">
                        <div class="mb-3">
                            <i class="fa fa-users fa-3x text-warning"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-success mb-2" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                            Active Patients
                        </h5>
                        <h2 class="display-6 fw-bold text-dark mb-0">
                            @Model.PatientsCount
                        </h2>
                    </div>
                </div>

                <!-- 2. Licensed Herbalists -->
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded-4 p-4 shadow-sm h-100 border">
                        <div class="mb-3">
                            <i class="fas fa-store-alt fa-3x text-warning"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-success mb-2" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                            Licensed Apothecaries
                        </h5>
                        <h2 class="display-6 fw-bold text-dark mb-0">
                            @Model.HerbalistsCount
                        </h2>
                    </div>
                </div>

                <!-- 3. Client Feedbacks -->
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded-4 p-4 shadow-sm h-100 border">
                        <div class="mb-3">
                            <i class="fas fa-comments fa-3x text-warning"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-success mb-2" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                            Client Feedbacks
                        </h5>
                        <h2 class="display-6 fw-bold text-dark mb-0">
                            @Model.FeedbacksCount
                        </h2>
                    </div>
                </div>

                <!-- 4. Dispatched Orders -->
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="counter bg-white rounded-4 p-4 shadow-sm h-100 border">
                        <div class="mb-3">
                            <i class="fas fa-box fa-3x text-warning"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-success mb-2" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                            Orders Dispatched
                        </h5>
                        <h2 class="display-6 fw-bold text-dark mb-0">
                            @Model.OrdersCount
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>