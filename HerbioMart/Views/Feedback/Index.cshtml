@model IEnumerable<HerbioMart.Models.Entities.Feedback>

@{
    ViewData["Title"] = "Patient Testimonials";
}

<style>
    .testimonial-avatar-initial {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: #2e7d32;
        color: #ffffff;
        font-size: 1.9rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        border: 3px solid #81c784;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        flex-shrink: 0;
    }

    .testimonial-avatar-img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #81c784;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        flex-shrink: 0;
    }

    .carousel-nav-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #81c784;
        background: #ffffff;
        color: #198754;
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 3px 8px rgba(0,0,0,0.08);
    }

        .carousel-nav-btn:hover {
            background: #198754;
            color: #ffffff;
            transform: scale(1.08);
        }
</style>

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Patient Stories</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-white">Shop</a></li>
        <li class="breadcrumb-item active text-white">Testimonials</li>
    </ol>
</div>
<!-- Single Page Header End -->
<!-- Testimonial Start -->
<div class="container-fluid testimonial py-5">
    <div class="container py-5">

        <!-- Header with Controls -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
            <div>
                <h4 class="text-primary text-uppercase" style="letter-spacing: 1px;">Verified Feedback</h4>
                <h1 class="display-5 text-dark fw-bold mb-0">What Our Patients Say!</h1>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (User.IsInRole("Patient"))
                {
                    <a asp-action="MyFeedbacks" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold me-2">
                        <i class="fas fa-user-edit me-1"></i> My Reviews
                    </a>
                }
                <button type="button" class="carousel-nav-btn" id="customPrevBtn" title="Previous Feedback">
                    <i class="fas fa-arrow-left"></i>
                </button>
                <button type="button" class="carousel-nav-btn" id="customNextBtn" title="Next Feedback">
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 bg-light rounded-4 border">
                <i class="far fa-comments fa-3x text-muted mb-3"></i>
                <h4 class="text-dark fw-bold">No Feedbacks Yet</h4>
                <p class="text-muted">Be the first patient to share your experience with our botanical formulations.</p>
                <a asp-controller="Recipe" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 mt-2">
                    Browse Formulations
                </a>
            </div>
        }
        else
        {
            <div class="owl-carousel testimonial-carousel">
                @foreach (var item in Model)
                {
                    var patientName = item.Patient?.User?.FullName ?? "Verified Patient";
                    var userInitial = !string.IsNullOrWhiteSpace(patientName) ? patientName.Trim()[0].ToString().ToUpper() : "P";
                    var userImage = item.Patient?.User?.ImageUrl;

                    <div class="testimonial-item img-border-radius bg-light rounded-4 p-4 position-relative">
                        <div class="position-relative">

                            <i class="fa fa-quote-right fa-2x text-secondary position-absolute" style="bottom: 25px; right: 0; opacity: 0.25;"></i>

                            <!-- Remedy Tag & View Button -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-white text-success border border-success border-opacity-25 px-3 py-2 rounded-pill small fw-semibold text-truncate" style="max-width: 65%;" title="@item.Recipe?.RecipeName">
                                    <i class="fas fa-mortar-pestle me-1"></i> @(item.Recipe?.RecipeName ?? "Therapeutic Recipe")
                                </span>

                                <a asp-controller="Recipe" asp-action="Details" asp-route-id="@item.RecipeId"
                                   class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                                   style="font-size: 0.78rem;">
                                    <span>View Remedy</span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>

                            <!-- Comment Text -->
                            <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-25" style="min-height: 75px;">
                                <p class="mb-0 text-dark" style="font-size: 0.95rem; line-height: 1.6;">
                                    @(string.IsNullOrWhiteSpace(item.Comment) ? "Patient verified the purchase without leaving a written comment." : $"\"{item.Comment}\"")
                                </p>
                            </div>

                            <!-- Patient Info -->
                            <div class="d-flex align-items-center flex-nowrap">

                                <div class="me-3">
                                    @if (!string.IsNullOrEmpty(userImage))
                                    {
                                        <img src="@userImage" class="testimonial-avatar-img" alt="@patientName">
                                    }
                                    else
                                    {
                                        <div class="testimonial-avatar-initial">
                                            @userInitial
                                        </div>
                                    }
                                </div>

                                <div class="d-block">
                                    <h5 class="text-dark fw-bold mb-0">@patientName</h5>
                                    <small class="text-muted d-block mb-1">
                                        <i class="far fa-calendar-alt me-1"></i> @item.RatingDate.ToString("MMM dd, yyyy")
                                    </small>

                                    <div class="d-flex align-items-center text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(item.RatingValue))
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-muted opacity-50"></i>
                                            }
                                        }
                                        <span class="ms-2 fw-bold text-dark font-monospace" style="font-size: 0.88rem;">
                                            @item.RatingValue.ToString("0.0")
                                        </span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
<!-- Testimonial End -->
@section Scripts {
    <script>
        $(document).ready(function() {
            var $carousel = $(".testimonial-carousel");

            $("#customPrevBtn").click(function() {
                $carousel.trigger("prev.owl.carousel");
            });

            $("#customNextBtn").click(function() {
                $carousel.trigger("next.owl.carousel");
            });
        });
    </script>
}