@model IEnumerable<HerbioMart.Models.Entities.Feedback>

@{
    ViewData["Title"] = "My Reviews";
}

<style>
    .page-header-top {
        margin-top: 150px;
    }
</style>

<div class="container page-header-top py-4">

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 p-3 d-flex align-items-center" role="alert">
            <i class="fas fa-check-circle fa-lg me-2 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Submitted Reviews</h2>
            <p class="text-muted mb-0">Manage and edit your feedback on herbal recipes.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fas fa-globe me-1"></i> View All Community Reviews
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-light rounded-4 border">
            <i class="fas fa-pen-alt fa-3x text-muted mb-3"></i>
            <h5 class="text-dark fw-bold">You haven't reviewed any recipes yet.</h5>
            <p class="text-muted small">Explore our recipes and share your experience with the community!</p>
            <a asp-controller="Recipe" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 mt-2">
                Browse Recipes
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Remedy Name</th>
                            <th class="py-3">Your Rating</th>
                            <th class="py-3" style="width: 40%;">Your Comment</th>
                            <th class="py-3">Date</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">@item.Recipe?.RecipeName</span>
                                </td>
                                <td>
                                    <div class="text-warning small d-flex align-items-center">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.RatingValue)
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-muted"></i>
                                            }
                                        }
                                        <span class="ms-2 fw-bold text-dark">@item.RatingValue.ToString("0.0")</span>
                                    </div>
                                </td>
                                <td>
                                    <p class="text-muted small mb-0 text-truncate" style="max-width: 400px;">
                                        @(string.IsNullOrWhiteSpace(item.Comment) ? "No written comments." : item.Comment)
                                    </p>
                                </td>
                                <td class="text-muted small">
                                    @item.RatingDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Create" asp-route-recipeId="@item.RecipeId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.FeedbackId" method="post" onsubmit="return confirm('Are you sure you want to delete this review?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fas fa-trash-alt me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>