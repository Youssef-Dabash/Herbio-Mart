@model HerbioMart.Models.Entities.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container-fluid page-header py-5 mb-4">
    <h1 class="text-center text-white display-6 fw-bold">Order Received</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item active text-white">Confirmation</li>
    </ol>
</div>

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center bg-light mb-4">
        <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
            <i class="fas fa-check"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Thank You for Your Order!</h3>
        <p class="text-muted">Your order has been recorded and successfully routed to the corresponding apothecaries for preparation.</p>
        <span class="badge bg-success bg-opacity-10 text-white border border-success border-opacity-25 px-4 py-2 fs-6 rounded-pill d-inline-block mx-auto font-monospace">
            Order Reference: #@Model.OrderId
        </span>
    </div>

    <!-- Routed SubOrders per Herbalist -->
    <h4 class="fw-bold text-dark mb-3">Apothecary Sub-Orders (@Model.SubOrders.Count)</h4>
    
    <div class="row g-4 mb-4">
        @foreach (var sub in Model.SubOrders)
        {
            <div class="col-md-6">
                <div class="card border rounded-4 shadow-sm p-4 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Dispensary: @sub.Herbalist.User.FullName</h6>
                            <small class="text-muted font-monospace">Sub-Order #@sub.SubOrderId</small>
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1">@sub.Status</span>
                    </div>

                    <ul class="list-unstyled mb-3 flex-grow-1 small">
                        @foreach (var herb in sub.OrderHerbs)
                        {
                            <li class="d-flex justify-content-between py-1">
                                <span><i class="fas fa-leaf text-success me-1"></i> @herb.Herb.HerbName (@herb.Quantity g)</span>
                                <strong class="font-monospace">@herb.SubTotal.ToString("0.00") EGP</strong>
                            </li>
                        }
                        @foreach (var recipe in sub.OrderRecipes)
                        {
                            <li class="d-flex justify-content-between py-1">
                                <span><i class="fas fa-mortar-pestle text-primary me-1"></i> @recipe.Recipe.RecipeName (@recipe.Quantity unit)</span>
                                <strong class="font-monospace">@recipe.SubTotal.ToString("0.00") EGP</strong>
                            </li>
                        }
                    </ul>

                    <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Vendor Subtotal:</span>
                        <strong class="text-success font-monospace fs-5">@sub.SubTotal.ToString("0.00") EGP</strong>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center gap-3 mt-4">
    <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm">
        <i class="fas fa-search-location me-1"></i> Track This Order
    </a>
    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
        <i class="fas fa-store me-1"></i> Return to Catalog
    </a>
</div>
</div>