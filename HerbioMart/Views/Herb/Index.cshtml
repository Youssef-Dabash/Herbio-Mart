@model IEnumerable<HerbioMart.ViewModels.Herb.HerbListItemVM>

@{
    ViewData["Title"] = "Botanical Herb Catalog";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Botanical Herb Catalog</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Home</a></li>
        <li class="breadcrumb-item active text-white">Botanical Catalog</li>
    </ol>
</div>
<!-- Single Page Header End -->

<div class="container-fluid py-5">
    <div class="container py-4">

        <!-- Top Header & Action -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2">
            <div>
                <h3 class="fw-bold text-dark mb-1">Registered Botanical Species</h3>
                <p class="text-muted small mb-0">Global catalog of certified medicinal plants and botanical specimens.</p>
            </div>

            @if (User.IsInRole("Herbalist"))
            {
                <a asp-controller="Herb" asp-action="Create" class="btn btn-success rounded-pill px-4 py-2 text-white fw-bold shadow-sm">
                    <i class="fas fa-plus-circle me-1"></i> Register New Herb
                </a>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <i class="fas fa-leaf fa-4x text-muted mb-3"></i>
                <h4 class="fw-bold text-dark">No Botanical Species Cataloged</h4>
                <p class="text-muted mb-4">No medicinal herbs have been registered in the database yet.</p>
                @if (User.IsInRole("Herbalist"))
                {
                    <div class="d-flex justify-content-center">
                        <a asp-controller="Herb" asp-action="Create" class="btn btn-success rounded-pill px-4 py-2">
                            Add First Herb
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Cards Grid Layout -->
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white d-flex flex-column transition-hover">

                            <!-- Herb Image Header -->
                            <div class="position-relative" style="height: 210px; background-color: #f8f9fa;">
                                <img src="@item.ImageURL"
                                     class="w-100 h-100 object-fit-cover"
                                     alt="@item.HerbName"
                                     onerror="this.onerror=null; this.src='/img/herb-placeholder.png';" />
                                <span class="position-absolute top-0 end-0 m-3 badge bg-white text-dark shadow-sm rounded-pill px-3 py-2 border small fw-semibold">
                                    <i class="fas fa-seedling text-success me-1"></i> Botanical
                                </span>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body p-4 d-flex flex-column">
                                <span class="font-monospace text-success small mb-1">
                                    <em>@item.ScientificName</em>
                                </span>

                                <h5 class="fw-bold text-dark mb-2">
                                    @item.HerbName
                                </h5>

                                <p class="text-muted small mb-4 flex-grow-1" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Description
                                </p>

                                <!-- Card Footer Action -->
                                <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                                    <small class="text-muted">
                                        <i class="fas fa-microscope text-primary me-1"></i> Verified Specimen
                                    </small>
                                    <a asp-controller="Herb" asp-action="Details" asp-route-id="@item.HerbId" class="btn btn-outline-success rounded-pill px-4 py-2 btn-sm fw-bold shadow-sm">
                                        <i class="fas fa-info-circle me-1"></i> View Details
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>